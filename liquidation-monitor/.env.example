# Copy to .env and `set -a; . ./.env; set +a` before running. Never commit .env.
# RPC endpoints (comma-separated = failover order). Prefer your own nodes.
LIQMON_RPC_BSC=https://bsc-rpc.publicnode.com
LIQMON_RPC_AVALANCHE=https://api.avax.network/ext/bc/C/rpc
# Optional archive endpoint used for anvil forks
# LIQMON_FORK_RPC_AVALANCHE=
# Foundry
LIQMON_ANVIL_BIN=anvil
# Deployed executor contracts (owner = the key below). Leave unset to stay scan-only.
# LIQMON_EXECUTOR_BSC=
# LIQMON_EXECUTOR_AVALANCHE=
# Executor only. The scanner never reads this.
# LIQMON_PRIVATE_KEY=
# Private/MEV-protected submission endpoints
# LIQMON_TX_RPC_BSC=
# LIQMON_TX_RPC_AVALANCHE=
# Keep true until you have reviewed everything.
LIQMON_DRY_RUN=true
# Alerts
# LIQMON_TELEGRAM_BOT_TOKEN=
# LIQMON_TELEGRAM_CHAT_ID=
# LIQMON_DISCORD_WEBHOOK_URL=
